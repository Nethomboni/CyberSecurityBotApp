<Window x:Class="CyberSecurityBotApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberSecurityBotApp"
        mc:Ignorable="d"
        Title="CyberSecurity Awareness Bot" Height="600" Width="800"
        Loaded="Window_Loaded"
        Background="#1C1C1C">
    <Grid Background="#1C1C1C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="          ██████████&#x20;
         ████████████&#x20;
        ██          ██&#x20;
       ██  ██████  ██&#x20;
       ██  ██ 🔒 ██  ██&#x20;
       ██  ██████  ██&#x20;
        ██          ██&#x20;
          ██████████&#x20;
           ████████&#x20;"
                       FontFamily="Consolas"
                       Foreground="Green"
                       HorizontalAlignment="Center"
                       FontSize="10"/>
            <TextBlock x:Name="WelcomeMessageTextBlock"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Foreground="Cyan"
                       HorizontalAlignment="Center"
                       FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="10,0,10,10" Background="#1C1C1C">
            <TabItem Header="Chat" Foreground="blue">
                <Grid Background="#282828">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ChatOutputTextBlock" TextWrapping="Wrap" Margin="5" Foreground="White"/>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UserInputTextBox" Grid.Column="0" KeyDown="UserInputTextBox_KeyDown" Margin="0,0,5,0" Padding="5" Text="Type your question or command here..." Background="#3A3A3A" Foreground="White"/>
                        <Button Content="Send" Grid.Column="1" Click="SendButton_Click" Padding="10,5"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Tasks" Foreground="blue">
                <Grid Background="#282828">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="23*"/>
                        <ColumnDefinition Width="751*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="5,5,5,5" Grid.ColumnSpan="2">
                        <TextBlock Text="Add New Task:" FontWeight="Bold" Foreground="White"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="White"/>
                            <TextBox x:Name="TaskTitleTextBox" Grid.Row="0" Grid.Column="1" Background="#3A3A3A" Foreground="White"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" VerticalAlignment="Center" Margin="0,5,5,0" Foreground="White"/>
                            <TextBox x:Name="TaskDescriptionTextBox" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Background="#3A3A3A" Foreground="White"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Reminder (Optional):" VerticalAlignment="Center" Margin="0,5,5,0" Foreground="White"/>
                            <DatePicker x:Name="ReminderDatePicker" Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" Foreground="White" Background="#3A3A3A"/>

                            <Grid Grid.Row="3" Grid.Column="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ReminderTimeTextBox" Grid.Column="0" Text="HH:MM" GotFocus="ReminderTimeTextBox_GotFocus" LostFocus="ReminderTimeTextBox_LostFocus" Background="#3A3A3A" Foreground="LightGray"/>
                                <Button Content="Add Task" Grid.Column="1" Margin="5,0,0,0" Click="AddTaskButton_Click"/>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="TasksListBox" Grid.Row="1" Margin="10,10,10,10" DisplayMemberPath="ToString" Background="#3A3A3A" Foreground="White" Grid.ColumnSpan="2"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="229,5,0,5" Grid.Column="1">
                        <Button Content="Mark Selected as Complete" Margin="0,0,10,0" Click="MarkTaskCompleteButton_Click"/>
                        <Button Content="Delete Selected Task" Click="DeleteTaskButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Quiz" Foreground="blue">
                <StackPanel Margin="10" Background="#282828">
                    <TextBlock x:Name="QuizQuestionTextBlock" TextWrapping="Wrap" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="black"/>
                    <RadioButton x:Name="Option1RadioButton" GroupName="QuizOptions" Content="Option 1" Margin="0,5" Click="QuizOption_Click" Foreground="White"/>
                    <RadioButton x:Name="Option2RadioButton" GroupName="QuizOptions" Content="Option 2" Margin="0,5" Click="QuizOption_Click" Foreground="White"/>
                    <RadioButton x:Name="Option3RadioButton" GroupName="QuizOptions" Content="Option 3" Margin="0,5" Click="QuizOption_Click" Foreground="White"/>
                    <RadioButton x:Name="Option4RadioButton" GroupName="QuizOptions" Content="Option 4" Margin="0,5" Click="QuizOption_Click" Foreground="White"/>
                    <Button x:Name="StartQuizButton" Content="Start Quiz" Margin="0,20,0,0" Click="StartQuizButton_Click" HorizontalAlignment="Center" Padding="20,10"/>
                    <TextBlock x:Name="QuizFeedbackTextBlock" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="14" FontStyle="Italic" Foreground="Cyan"/>
                    <TextBlock x:Name="QuizScoreTextBlock" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Foreground="Cyan"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Activity Log" Foreground="blue">
                <ScrollViewer VerticalScrollBarVisibility="Visible" Background="#282828">
                    <TextBlock x:Name="ActivityLogTextBlock" TextWrapping="NoWrap" Margin="5" Foreground="PaleVioletRed"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="#222" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Bot Ready."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>